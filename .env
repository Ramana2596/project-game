REACT_APP_API_BASE_URL = https://daring-pro-silkworm.ngrok-free.app
REACT_APP_DEV_API_BASE_URL = http://localhost:4000

# ===== MODE SWITCH: keep exactly ONE of the next two lines active =====

# 1 . Development ON  -> calls go to localhost:4000 (no ngrok)
# REACT_APP_USE_PROD_API=false

# 2 . Production ON   -> calls go to ngrok. To use it:
##   put # in front of the "=false" line in section 1,
##   and remove # from the "=true" line below
REACT_APP_USE_PROD_API=true

# After any change: stop npm start (Ctrl+C) and start it again